# Public site URL used for canonical metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase server integration. The secret key must never use NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
CONTACT_HASH_SECRET=replace-with-at-least-32-random-characters

# Optional email notification through Resend. Submissions still save without it.
RESEND_API_KEY=re_REPLACE_ME
CONTACT_TO_EMAIL=ezz.ali9939@gmail.com
CONTACT_FROM_EMAIL=Portfolio <inquiries@your-verified-domain.com>
